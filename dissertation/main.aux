\@writefile{lot}{\contentsline {table}{\numberline {8.1}{\ignorespaces Route~B training summary. Symmetric Chamfer loss $L = \mathrm  {CD}(C,G)+\mathrm  {CD}(F,G)$ on unit-normalised clouds. All three runs converge: the final training CD is 1--2 orders of magnitude below its epoch-1 value, and validation CD stays below training CD, indicating no memorisation at the sampled checkpoints.}}{44}{table.caption.29}\protected@file@percent }
\newlabel{tab:routeB_training}{{8.1}{44}{Route~B training summary. Symmetric Chamfer loss $L = \mathrm {CD}(C,G)+\mathrm {CD}(F,G)$ on unit-normalised clouds. All three runs converge: the final training CD is 1--2 orders of magnitude below its epoch-1 value, and validation CD stays below training CD, indicating no memorisation at the sampled checkpoints}{table.caption.29}{}}
